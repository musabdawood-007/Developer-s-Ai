{
  "name": "Developer's Ai",
  "short_name": "Dev's Ai",
  "description": "A friendly chatbot by Musab Dawood — chat, get coding tips, generate images & Markdown files.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0d0505",
  "theme_color": "#c41e3a",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Chat",
      "url": "/?action=new-chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Generate Image",
      "url": "/?action=generate-image",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
