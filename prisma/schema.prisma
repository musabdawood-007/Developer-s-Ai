// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- PULSE: visitor + chat logging ---

model Visitor {
  id              String        @id @map("_id") @default(cuid())
  email           String        @unique
  name            String
  password        String?
  profilePicture  String?
  sessionId       String        @unique
  isGuest         Boolean       @default(false)
  isPro           Boolean       @default(false)
  proExpiresAt    DateTime?
  createdAt       DateTime      @default(now())
  lastSeen        DateTime      @updatedAt
  chats           ChatLog[]
  sessions        ChatSession[]
  modelUsages     ModelUsage[]
  feedback        Feedback[]

  @@map("visitors")
}

model ChatSession {
  id        String    @id @map("_id") @default(cuid())
  visitorId String
  visitor   Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chats     ChatLog[]

  @@map("chat_sessions")
}

model ChatLog {
  id           String       @id @map("_id") @default(cuid())
  visitorId    String
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  content      String
  modelId      String?
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  userHiddenAt DateTime?

  @@index([visitorId])
  @@index([sessionId])
  @@map("chat_logs")
}

// Tracks daily message usage per visitor per model.
// One row per (visitor, model, day). Reset daily by checking `date`.
model ModelUsage {
  id        String   @id @map("_id") @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  modelId   String   // e.g. "pulse-listener", "pulse-deep"
  date      String   // YYYY-MM-DD (UTC) — daily bucket
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitorId, modelId, date])
  @@index([visitorId, date])
  @@map("model_usages")
}

// Feedback loop: thumbs up/down after every PULSE reply.
// Used later to fine-tune prompts (PRD §7).
model Feedback {
  id        String   @id @map("_id") @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  modelId   String?
  rating    String   // "up" | "down"
  comment   String?
  createdAt DateTime @default(now())

  @@index([modelId])
  @@index([rating])
  @@map("feedback")
}

model OtpToken {
  id        String   @id @map("_id") @default(cuid())
  email     String
  otp       String
  type      String   // "signup" or "reset"
  metadata  String?  // JSON string for extra data (name, hashedPassword for signup)
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("otp_tokens")
}
